{
  "name": "nokakoi-app",
  "version": "1.124.3",
  "description": "Nostr Web Client",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8000",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:update": "node scripts/update-version.js",
    "version:check": "node scripts/update-version.js --check",
    "lint": "eslint js/**/*.js",
    "lint:fix": "eslint js/**/*.js --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "http-server": "^14.1.1",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "nostr-tools": "^2.24.1",
    "qrcode-generator": "^2.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
